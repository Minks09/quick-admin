# --- Base de données ---
# SQLite par défaut ; pour Postgres : postgresql+psycopg://user:pass@localhost/politrace
DATABASE_URL=sqlite:////opt/politrace/data/politrace.db

# --- API Claude (résumés quotidiens) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Sources de données ---
PARLAMENT_ODATA=https://ws.parlament.ch/odata.svc
# Interface REST officielle « dataIF » (OpenAPI 3.0) sur cms.lobbywatch.ch.
# Vérifiez le chemin exact de la table dans la spec (lobbywatch.ch → Datenexport)
# et adaptez LW_FIELD_MAP dans scraper/sync_interests.py au schéma réel.
# Alternative robuste : exports hebdomadaires (lundi matin) CSV/JSON à télécharger.
# Usage libre et gratuit mais soumis à leur mémento (attribution) — à lire avant tout usage commercial.
LOBBYWATCH_API=https://cms.lobbywatch.ch/de/data/interface/v1/json/table/parlamentarier/flat/list

# --- Instagram (optionnel, publication automatique) ---
# Nécessite un compte Instagram professionnel lié à une page Facebook + app Meta.
META_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_ID=
# URL publique où les images générées sont servies (l'API Meta exige des URLs publiques)
PUBLIC_BASE_URL=https://votre-domaine.ch

# --- Divers ---
SITE_NAME=Politrace
DEFAULT_LANG=fr

# --- Comptes utilisateurs et alertes ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SMTP pour l'envoi des alertes e-mail (laisser vide = mode dry-run en console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@votre-domaine.ch


# --- Backend des résumés ---
# api        : SDK Anthropic avec ANTHROPIC_API_KEY (recommandé, fiable)
# claude_cli : Claude Code (`claude -p`) connecté à un abonnement Pro/Max —
#              quota de l'abonnement, voir README §Backend des résumés
SUMMARIZER_BACKEND=api

# --- Communiqués fédéraux (News Service Bund) ---
# Format : "ABBR|URL" séparés par des virgules (ABBR = badge affiché sur le site).
# Hôte canonique : www.news.admin.ch — variante constatée fonctionnelle :
# d-nsbc-p.admin.ch (même chemin NSBSubscriber/feeds/rss, mêmes paramètres).
# kind=M = communiqués de presse ; org-nr = organisation émettrice.
#
# ÉTAPE 1 — identifiez vos org-nr (la correspondance n'est pas documentée) :
#   python -m scraper.gov_news discover 1-30 101 201 301 401 501 601 701 801 1101
#   → affiche le nom du canal pour chaque numéro. Repérez : Conseil fédéral,
#     Chancellerie (ChF), DFAE, DFI, DFJP, DDPS, DFF, DEFR, DETEC.
#     (constaté : 401 ≈ DFJP, 404 ≈ fedpol — vérifiez le vôtre : 1101 = ?)
#
# ÉTAPE 2 — remplissez la liste. Organisations recommandées pour Politrace :
#   Priorité 1 : CF (Conseil fédéral), ChF, DFAE, DFI, DFJP, DDPS, DFF, DEFR, DETEC
#   Priorité 2 (alertes B2B sectorielles) : OFSP, SECO, OFEV, OFEN, AFC
# Exemple (REMPLACEZ les org-nr par ceux trouvés à l'étape 1) :
# GOV_RSS_FEEDS=CF|https://www.news.admin.ch/NSBSubscriber/feeds/rss?lang=fr&topic=&kind=M&org-nr=1,DFI|https://www.news.admin.ch/NSBSubscriber/feeds/rss?lang=fr&topic=&kind=M&org-nr=201
#
# Démarrage avec le flux que vous avez déjà identifié (org-nr=1101) :
GOV_RSS_FEEDS=CF|https://www.news.admin.ch/NSBSubscriber/feeds/rss?lang=fr&topic=&kind=M&org-nr=1101

# Gabarit utilisé par le mode discover ({org} est remplacé par le numéro).
# Si www.news.admin.ch ne répond pas, utilisez la variante :
# GOV_RSS_BASE=https://d-nsbc-p.admin.ch/NSBSubscriber/feeds/rss?lang=fr&topic=&kind=M&org-nr={org}
GOV_RSS_BASE=https://www.news.admin.ch/NSBSubscriber/feeds/rss?lang=fr&topic=&kind=M&org-nr={org}
